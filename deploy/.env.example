# =====================================================
# Vedium LMS — Variáveis de Ambiente (template)
# Stack real (produção): Frappe v16 / Python 3.14 / MariaDB 10.6
# =====================================================
# 1) Copie este arquivo:        cp deploy/.env.example /opt/vedium/.env
# 2) Gere senhas fortes:        openssl rand -base64 32
# 3) Preencha cada CHANGE_ME abaixo
# 4) NUNCA commite o .env       (já está no .gitignore)
# =====================================================

# ===========================================
# Server / Domain
# ===========================================
SERVER_IP=CHANGE_ME
DOMAIN=vediums.com
ADMIN_EMAIL=admin@vediums.com

# ===========================================
# MariaDB
# ===========================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=vedium
MYSQL_USER=frappe
MYSQL_PASSWORD=CHANGE_ME
# Redis password (aplicado às 3 instâncias — cache, queue, socketio)
# Gerar: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME

# ===========================================
# Frappe / ERPNext (v16)
# ===========================================
FRAPPE_ADMIN_PASSWORD=CHANGE_ME
FRAPPE_SITE_NAME=app.vediums.com
# Workers = (2 × CPU_CORES) + 1  — ex: 4 CPUs → 9 workers
GUNICORN_WORKERS=4

# ===========================================
# Aplicação
# ===========================================
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
SITE_URL=https://vediums.com
APP_URL=https://app.vediums.com
DEVELOPER_MODE=0

# ===========================================
# Backups via restic (P0.2)
# Gerar RESTIC_PASSWORD: openssl rand -base64 32
# Bucket: Wasabi (us-east-1) ou Cloudflare R2
# ===========================================
RESTIC_REPOSITORY=s3:https://s3.us-east-1.wasabisys.com/vedium-backup
RESTIC_PASSWORD=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Diretório onde o docker-compose.yml está no servidor
COMPOSE_DIR=/opt/vedium

# ===========================================
# E-mail / SMTP
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@vediums.com
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true

# ===========================================
# Pagamentos (preencha quando ativar)
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
COINBASE_API_KEY=

# ===========================================
# IA (preencha quando ativar)
# ===========================================
OPENAI_API_KEY=
GROQ_API_KEY=

# ===========================================
# Observabilidade — Uptime Kuma local + serviços externos
# Stack interna (Prometheus/Grafana/Loki) removida em 2026-06-11 (ADR-005).
# Para métricas/dashboards externos: Grafana Cloud free, Uptime Robot.
# Subir Kuma local: make uptime-up  → http://localhost:3004
# ===========================================

# ===========================================
# Alertas Telegram (opcional — altamente recomendado)
# Criar bot: @BotFather → /newbot
# Obter chat_id: @userinfobot
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===========================================
# CI/CD — GitHub Secrets (NÃO definir aqui, definir no GitHub)
# ===========================================
# GH_TOKEN, SSH_PRIVATE_KEY, SERVER_HOST — via GitHub Secrets
# SSH_PRIVATE_KEY  → Settings > Secrets and variables > Actions
# SSH_KNOWN_HOSTS  → ssh-keyscan SEU_SERVIDOR
# DEPLOY_USER      → usuário não-root com sudo
# DEPLOY_HOST      → IP/hostname

# ===========================================
# Notificações opcionais
# ===========================================
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
