# =====================================================
# Vedium LMS — Variáveis de Ambiente (template)
# =====================================================
# 1) Copie este arquivo:        cp deploy/.env.example /opt/vedium/.env
# 2) Gere senhas fortes:        openssl rand -base64 32
# 3) Preencha cada CHANGE_ME abaixo
# 4) NUNCA commite o .env       (já está no .gitignore)
# =====================================================

# ===========================================
# Server / Domain
# ===========================================
SERVER_IP=CHANGE_ME
DOMAIN=vediums.com
ADMIN_EMAIL=admin@vediums.com

# ===========================================
# MariaDB
# ===========================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=vedium
MYSQL_USER=frappe
MYSQL_PASSWORD=CHANGE_ME

# ===========================================
# Frappe / ERPNext
# ===========================================
FRAPPE_ADMIN_PASSWORD=CHANGE_ME
FRAPPE_SITE_NAME=app.vediums.com

# ===========================================
# Aplicação
# ===========================================
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME
SITE_URL=https://vediums.com
APP_URL=https://app.vediums.com
DEVELOPER_MODE=0

# ===========================================
# Backups
# ===========================================
BACKUP_ENCRYPTION_KEY=CHANGE_ME
BACKUP_DIR=/opt/vedium/backups
BACKUP_RETENTION_DAYS=30

# ===========================================
# E-mail / SMTP
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@vediums.com
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true

# ===========================================
# Pagamentos (preencha quando ativar)
# ===========================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
BASECOMMERCE_API_KEY=
BASECOMMERCE_SECRET=
COINBASE_API_KEY=

# ===========================================
# IA (preencha quando ativar)
# ===========================================
OPENAI_API_KEY=
GROQ_API_KEY=

# ===========================================
# Observabilidade (apenas se usar profile observability)
# ===========================================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ===========================================
# CI/CD — GitHub Secrets (NÃO definir aqui, definir no GitHub)
# ===========================================
# SSH_PRIVATE_KEY  → Settings > Secrets and variables > Actions
# SSH_KNOWN_HOSTS  → ssh-keyscan SEU_SERVIDOR
# DEPLOY_USER      → usuário não-root com sudo
# DEPLOY_HOST      → IP/hostname

# ===========================================
# Notificações opcionais
# ===========================================
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
